# ==========================================
# Root .gitignore for DataPilot Project
# Covers: .NET Core/C#, Python (FastAPI), React (Vite/Node), IDEs & OS
# ==========================================

# ------------------------------------------
# Environment variables & secrets
# ------------------------------------------
.env
.env.*
!.env.example
*.local
*.secrets.json
appsettings.Production.json
appsettings.*.local.json

# ------------------------------------------
# Operating System files
# ------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini

# ------------------------------------------
# IDEs and Editors
# ------------------------------------------
.vs/
.idea/
*.suo
*.user
*.userosscache
*.sln.docstates
*.userprefs
*.DotSettings.user
*.sw?
*~

# VS Code (keep shared configurations if needed)
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# ------------------------------------------
# .NET / C# Build Artifacts
# ------------------------------------------
**/[Bb]in/
**/[Oo]bj/
[Bb]in/
[Oo]bj/
[Tt]est[Rr]esults/
[Bb]uild[Ll]og.*
*.publishproj
*.pubxml
*.nupkg
packages/
!packages/build/
project.lock.json
project.fragment.lock.json
artifacts/

# ------------------------------------------
# Python / FastAPI (ai-service)
# ------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual Environments
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

# Uploads & Temporary files
temp_uploads/
uploads/
*.tmp

# Testing & Coverage
.cache
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.mypy_cache/
.ruff_cache/

# ------------------------------------------
# Frontend / React / Node.js
# ------------------------------------------
node_modules/
frontend/dist/
frontend/dist-ssr/
frontend/.cache/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ------------------------------------------
# Databases & Local Data
# ------------------------------------------
*.sqlite
*.sqlite3
*.db
*.db-shm
*.db-wal
*.mdf
*.ldf
